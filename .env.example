# Copy to .env only if you want local overrides. This repository does not
# auto-load .env. Never commit .env. Leave keys empty: the default path has no vendor client.

# ROI model
ROI_LOG_LEVEL=INFO
ROI_OUTPUT_DIR=out
ROI_ASSUMPTIONS=assumptions/refund_desk.yaml
ROI_SEED=42
ROI_PROVIDER=template
ROI_MC_DRAWS=2000
ROI_COST_CAP=0
ROI_ENABLE_REAL_PROVIDER=0
ROI_PROVIDER_API_KEY=

# Build-vs-buy decision kit
DECIDE_LOG_LEVEL=INFO
DECIDE_REAL_PROVIDER=0
DECIDE_PROVIDER_BASE_URL=
DECIDE_PROVIDER_API_KEY=
DECIDE_MAX_ATTEMPTS=3
DECIDE_BACKOFF_CAP_SECONDS=2
DECIDE_COST_CAP_USD=0
